# Optional backend. Generate a unique value; never commit the real secret.
JWT_SECRET=replace-with-at-least-48-random-characters
SQLITE_PATH=./backend/recode.db
CORS_ORIGINS=http://127.0.0.1:3000
ENABLE_DOCS=0

# Optional Web cloud sync endpoint. Leave empty for local-first mode.
NEXT_PUBLIC_RECODE_API=
APP_ENV=production
CLOUD_AUTH_ENABLED=0
